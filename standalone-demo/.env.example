# Metro Ticket Generating System (MTTS) - Full-Stack Environment Variables
# Application Scope: x_mtts

# Server Port (Render sets this automatically in production)
PORT=5000

# Environment Mode: development | production | test
NODE_ENV=production

# MongoDB Atlas Connection String
# In production (NODE_ENV=production): MONGODB_URI is strictly required; silent fallback to mock is prohibited.
# On Render: Provide your connection string as a secret environment variable (sync: false).
# In local development / test: If left blank or unset, an isolated in-memory mock engine is used.
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# MongoDB Database Name
MONGODB_DB_NAME=mtts_transit_db

# Allowed CORS Origin (e.g. https://your-demo-name.onrender.com or * for open demo)
CORS_ORIGIN=*
