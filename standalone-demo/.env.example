# ==============================================================================
# Metro Ticket Generating System (MTTS) — Environment Configuration Template
# Application Scope: x_mtts
# Copy this file to .env and configure local values.
# IMPORTANT: Never commit actual credentials, passwords, or connection strings to Git!
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas Persistent Database Configuration
# In production (NODE_ENV=production): MONGODB_URI is strictly required; silent fallback to mock is prohibited.
# On Render: Provide your connection string as a secret environment variable (sync: false).
# In local development: If left blank or unset, an isolated in-memory mock engine is used.
MONGODB_URI=
MONGODB_DB_NAME=mtts_transit_db

# Allowed CORS Origin (e.g. https://your-demo-name.onrender.com or * for open demo)
CORS_ORIGIN=*

# Station Duty Approver Authentication (x_mtts.approver)
# Required in production: Must be supplied securely via Render Secret Environment Variables (sync: false)
# In development/test only, fallback defaults are provided if left unconfigured.
APPROVER_USERNAME=station_duty_manager
APPROVER_PASSWORD=ChangeMeInProduction_ComplexPassword123!
SESSION_SECRET=ChangeMeInProduction_Random32ByteSigningSecretHexOrBase64

# Safety Gate: Cancellation & Refund Policy (Mirrors x_mtts.cancellation.policy_status)
# Default: UNCONFIGURED (Prevents unauthorized monetary refund calculations without administrative sign-off)
CANCELLATION_POLICY_STATUS=UNCONFIGURED
