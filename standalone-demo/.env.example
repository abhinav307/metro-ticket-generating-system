# Metro Ticket Generating System (MTTS) - Full-Stack Environment Variables
# Application Scope: x_mtts

# Server Port (Render sets this automatically in production)
PORT=5000

# Environment Mode: development | production | test
NODE_ENV=production

# PostgreSQL Database Connection String
# On Render: Link a PostgreSQL Managed Database and Render provides DATABASE_URL automatically.
# Local Fallback: If left blank or unset, the application automatically uses an embedded PostgreSQL engine (pg-mem) with zero setup required.
# DATABASE_URL=postgresql://username:password@dpg-xxxxxx-a.oregon-postgres.render.com/mtts_db

# Allowed CORS Origin (e.g. https://your-demo-name.onrender.com or * for open demo)
CORS_ORIGIN=*
