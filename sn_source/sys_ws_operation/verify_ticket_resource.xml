<?xml version="1.0" encoding="UTF-8"?>
<record_update table="sys_ws_operation">
  <sys_ws_operation action="INSERT_OR_UPDATE">
    <active>true</active>
    <consumes>application/json</consumes>
    <consumes_customized>false</consumes_customized>
    <default_operation_uri/>
    <enforce_acl>x_mtts.scanner</enforce_acl>
    <http_method>POST</http_method>
    <name>Verify Ticket</name>
    <operation_script><![CDATA[(function process(/*RESTAPIRequest*/ request, /*RESTAPIResponse*/ response) {
    var verifier = new x_mtts.MetroScannerVerificationService();
    return verifier.processRestRequest(request, response);
})(request, response);]]></operation_script>
    <operation_uri>/api/x_mtts/scanner/verify-ticket</operation_uri>
    <produces>application/json</produces>
    <produces_customized>false</produces_customized>
    <relative_path>/verify-ticket</relative_path>
    <request_example>{
  "ticket_number": "TKT-20261015-000001",
  "token": "4a7b9c1d2e3f4a5b6c7d8e9f0a1b2c3d",
  "scanner_id": "GATE-CENTRAL-01",
  "station_code": "STN-01"
}</request_example>
    <requires_acl_authorization>true</requires_acl_authorization>
    <requires_authentication>true</requires_authentication>
    <short_description>Verifies digital metro ticket QR token against authoritative records</short_description>
    <sys_package display_value="Metro Ticket Generating System" source="x_mtts">x_mtts</sys_package>
    <sys_scope display_value="Metro Ticket Generating System">x_mtts</sys_scope>
    <web_service_definition display_value="Metro Turnstile Scanner API">scanner</web_service_definition>
  </sys_ws_operation>
</record_update>
